# Copy to .env and fill in; shell-exported values win over this file.

# Apple Developer team ID (10 characters, from developer.apple.com > Membership)
APPLE_TEAM_ID=
# Bundle identifier of the app
APP_IDENTIFIER=dev.lodge.Lodge

# Sign in to App Store Connect one of two ways; the key file wins when both are set.
#
# Way 1, App Store Connect API key (no prompts). Users and Access > Integrations > Keys;
# role App Manager is enough, but creating certificates through the API (a first
# MATCH_READONLY=false run) may need Admin.
# ASC_KEY_ID=
# Issuer ID (UUID shown above the key list)
# ASC_ISSUER_ID=
# Optional: path to the AuthKey_<ASC_KEY_ID>.p8 file, relative to the repo root or absolute.
# Unset, it is looked for in ~/.appstoreconnect/private_keys, ~/private_keys, ~/.private_keys
# and ./private_keys (git-ignored)
# ASC_KEY_PATH=
#
# Way 2, Apple ID; expect a second-factor prompt about monthly. The app-specific password
# (appleid.apple.com) is for notarizing and the TestFlight upload; other steps use the account
# password, asked once and kept in the login keychain (deliver.<APPLE_ID>), or FASTLANE_PASSWORD.
# APPLE_ID=
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=
# FASTLANE_PASSWORD=

# Private git repo that match stores certificates and profiles in; shared with the team's
# other apps, match keeps them apart by bundle ID
MATCH_GIT_URL=
# Passphrase match encrypts that repo with. Leave unset on a machine that has run match
# before (it is in the login keychain); only a keychain-less machine needs it
# MATCH_PASSWORD=
# Optional: base64 of "user:token" for HTTPS access to the match repo
# MATCH_GIT_BASIC_AUTHORIZATION=
# Optional: false lets match create missing certificates and profiles (default true)
MATCH_READONLY=true
# Optional: GitHub repo (owner/name) to publish the GitHub Release to; setting it turns the
# release on. Without it the release is skipped and the notarized DMG stays in build/fastlane/
# GITHUB_REPOSITORY=
# GitHub token with contents:write on that repo; required once GITHUB_REPOSITORY is set
# (a token exported in the shell alone does not turn the release on)
# GITHUB_TOKEN=
