    "A tab you have not looked at for this long gives up its memory, and picks up where it was when you come back." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過這段時間沒有查看的分頁會釋放記憶體，回來時會從原本的位置繼續。"
          }
        }
      }
    },
