require "digest"
require "dotenv"
require "open3"
require "openssl"
require "plist"

Dotenv.load(File.expand_path("../.env", __dir__))

# An empty value is "" in Ruby, which is truthy: match would take `MATCH_PASSWORD=` as the
# passphrase and never ask the keychain. Empty means unset, for every optional key.
%w[
  MATCH_PASSWORD
  MATCH_GIT_BASIC_AUTHORIZATION
  MATCH_READONLY
  ASC_KEY_ID
  ASC_ISSUER_ID
  ASC_KEY_PATH
  APPLE_ID
  FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD
  FASTLANE_PASSWORD
  GITHUB_TOKEN
  GITHUB_REPOSITORY
].each { |name| ENV.delete(name) if ENV[name].to_s.empty? }

REQUIRED_ENV = %w[
  APPLE_TEAM_ID
  APP_IDENTIFIER
  MATCH_GIT_URL
].freeze

ASC_KEY_ENV = %w[ASC_KEY_ID ASC_ISSUER_ID].freeze
APPLE_ID_ENV = %w[APPLE_ID FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD].freeze

# fastlane interpolates the ASC IDs and the Apple ID login into shell commands and logs
# MATCH_GIT_URL, so their shape is checked too.
ENV_SHAPES = {
  "ASC_KEY_ID" => [/\A[A-Z0-9]+\z/, "must be upper-case letters or digits"],
  "ASC_ISSUER_ID" => [/\A\h{8}-\h{4}-\h{4}-\h{4}-\h{12}\z/, "must be a UUID"],
  "APPLE_ID" => [/\A[\w.+-]+@[\w.-]+\z/, "must be an email address"],
  "FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD" => [/\A[a-z]{4}(-[a-z]{4}){3}\z/, "must look like xxxx-xxxx-xxxx-xxxx"],
  "GITHUB_REPOSITORY" => [%r{\A[\w.-]+/[\w.-]+\z}, "must be owner/name"]
}.freeze

def env_problems
  required = REQUIRED_ENV + (github_release? ? ["GITHUB_TOKEN"] : [])
  missing = required.select { |key| ENV[key].to_s.strip.empty? }
  problems = missing.empty? ? [] : ["Missing in .env: #{missing.join(', ')}"]
  ENV_SHAPES.each do |key, (shape, rule)|
    next if ENV[key].to_s.strip.empty?

    problems << "#{key} #{rule}" unless ENV[key].match?(shape)
  end
  if ENV["MATCH_GIT_URL"].to_s.match?(%r{\Ahttps?://[^/]*@|\A[\w+.-]+://[^/@]*:[^/@]*@}i)
    problems << "MATCH_GIT_URL must not carry credentials (user:token@); put them in MATCH_GIT_BASIC_AUTHORIZATION"
  end
  problems << sign_in_problem unless asc_key_ready? || apple_id_ready?
  problems
end

def env_valid?(key)
  ENV.key?(key) && ENV[key].match?(ENV_SHAPES[key].first)
end

def asc_key_ready?
  ASC_KEY_ENV.all? { |key| env_valid?(key) } && !asc_key_path.nil?
end

def apple_id_ready?
  APPLE_ID_ENV.all? { |key| env_valid?(key) }
end

def sign_in_problem
  key = "AuthKey_#{env_valid?('ASC_KEY_ID') ? ENV['ASC_KEY_ID'] : '<ASC_KEY_ID>'}.p8"
  key_missing = ASC_KEY_ENV.reject { |name| ENV.key?(name) }
  apple_missing = APPLE_ID_ENV.reject { |name| ENV.key?(name) }
  [
    "No way to sign in to App Store Connect; set up one of:",
    "    1. API key: #{key_missing.empty? ? '' : "set #{key_missing.join(', ')}, and "}put #{key} in one of",
    *asc_key_candidates(key).map { |path| "         #{path}" },
    "       or set ASC_KEY_PATH",
    "    2. Apple ID: #{apple_missing.empty? ? 'fix the values above' : "set #{apple_missing.join(', ')}"}"
  ].join("\n")
end

# Switched on by GITHUB_REPOSITORY, so a token exported for gh alone does not publish a release.
def github_release?
  ENV.key?("GITHUB_REPOSITORY")
end

# ASC_KEY_PATH (relative to the repo root), else the directories notarytool and altool also
# search, home ones first.
def asc_key_candidates(name = "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
  return [File.expand_path(ENV["ASC_KEY_PATH"], project_root)] if ENV.key?("ASC_KEY_PATH")

  [
    "~/.appstoreconnect/private_keys",
    "~/private_keys",
    "~/.private_keys",
    File.join(project_root, "private_keys")
  ].map { |dir| File.join(File.expand_path(dir), name) }
end

def asc_key_path
  asc_key_candidates.find { |path| File.file?(path) && File.readable?(path) }
end

# abort_with_message!, minus the Fastfile excerpt fastlane prints for an error raised with
# Fastfile lines in its backtrace: only "[!] message" (and any indented hint lines) shows.
def stop!(message, hint = nil)
  error = FastlaneCore::Interface::FastlaneCommonException.new([message, hint && "    #{hint}"].compact.join("\n"))
  error.set_backtrace([])
  raise error
end

desc "Fail unless every key publish needs is set, and well formed, in .env or the shell"
lane :check_env do
  problems = env_problems
  unless problems.empty?
    stop!([".env check found #{problems.size} problem(s) in .env:", *problems.map { |problem| "  - #{problem}" }].join("\n"))
  end
  UI.success("All required .env keys are set")
end

desc "Fail unless .env is ready and the tree can be released, before any platform uploads"
lane :preflight do
  check_env
  require_releasable
  UI.success("Ready to publish #{release_tag}")
end

PROJECT = "Lodge.xcodeproj".freeze
PBXPROJ = File.join(PROJECT, "project.pbxproj").freeze
OUTPUT_DIR = "build/fastlane".freeze
PBXPROJ_BACKUP = File.join(OUTPUT_DIR, "project.pbxproj.bak").freeze

platform :mac do
  desc "Ship macOS: TestFlight pkg, then a notarized Developer ID DMG (on a GitHub Release when GITHUB_REPOSITORY is set), then a local tag"
  lane :publish do
    require_releasable
    build_number = next_build_number
    app_store(build_number: build_number)
    dmg = developer_id(build_number: build_number)
    if github_release?
      release_on_github(dmg)
    else
      UI.important("GITHUB_REPOSITORY not set: GitHub release skipped; DMG at #{dmg}")
    end
    add_git_tag(tag: release_tag)
  end

  desc "Build a notarized Developer ID DMG into build/fastlane/ (option build_number)"
  lane :developer_id do |options|
    build_number = options[:build_number] || next_build_number
    match_signing("developer_id")
    app = with_lodge_signing("developer_id") do |identity|
      build_mac_app(
        project: PROJECT,
        scheme: "Lodge",
        export_method: "developer-id",
        output_directory: File.join(OUTPUT_DIR, "developer-id"),
        skip_package_pkg: true,
        export_options: { signingCertificate: identity },
        xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
      )
    end
    dmg = File.expand_path(File.join(OUTPUT_DIR, "Lodge-#{lodge_version}.dmg"), project_root)
    sh("hdiutil", "create", "-volname", "Lodge", "-srcfolder", app, "-ov", "-format", "UDZO", dmg)
    sh("codesign", "--force", "--timestamp", "--sign", identity_for("developer_id"), dmg)
    notarize(package: dmg, asc_provider: ENV["APPLE_TEAM_ID"], **asc_auth)
    dmg
  end

  desc "Build the Mac App Store pkg into build/fastlane/ and upload it to TestFlight (option build_number)"
  lane :app_store do |options|
    build_number = options[:build_number] || next_build_number
    match_signing("appstore", additional_cert_types: ["mac_installer_distribution"])
    pkg = with_lodge_signing("appstore") do |identity|
      build_mac_app(
        project: PROJECT,
        scheme: "Lodge",
        export_method: "app-store",
        output_directory: File.join(OUTPUT_DIR, "app-store"),
        installer_cert_name: installer_identity,
        export_options: { signingCertificate: identity },
        xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
      )
    end
    upload_to_testflight(pkg: pkg, app_platform: "osx", **asc_auth)
    pkg
  end
end

platform :ios do
  desc "Ship iOS and iPadOS to TestFlight; skipped while Lodge.xcodeproj has no such target"
  lane :publish do
    target = ios_target("1") || ios_target("2")
    next ship_to_testflight(target) if target

    UI.important("iOS: no target in Lodge.xcodeproj, skipped")
    UI.important("iPadOS: no target in Lodge.xcodeproj, skipped")
  end

  desc "Build the iOS app into build/fastlane/ and upload it to TestFlight; skipped without an iOS target"
  lane :ios do
    target = ios_target("1")
    target ? ship_to_testflight(target) : UI.important("iOS: no target in Lodge.xcodeproj, skipped")
  end

  desc "Build the iPadOS app into build/fastlane/ and upload it to TestFlight; skipped without an iPad target"
  lane :ipados do
    target = ios_target("2")
    target ? ship_to_testflight(target) : UI.important("iPadOS: no target in Lodge.xcodeproj, skipped")
  end
end

# The single universal iphoneos target, when it serves the device family ("1" iPhone, "2" iPad).
def ios_target(family)
  require "xcodeproj"
  targets = Xcodeproj::Project.open(File.join(project_root, PROJECT)).native_targets.select do |target|
    target.product_type == "com.apple.product-type.application" &&
      target.resolved_build_setting("SDKROOT", true).values.include?("iphoneos")
  end
  if targets.size > 1
    stop!("Lodge.xcodeproj has several iphoneos app targets: #{targets.map(&:name).join(', ')}",
          "they would share APP_IDENTIFIER; keep one universal target")
  end
  target = targets.first
  return unless target

  families = target.resolved_build_setting("TARGETED_DEVICE_FAMILY", true).values
  target if families.any? { |value| value.to_s.split(",").map(&:strip).include?(family) }
end

def ship_to_testflight(target)
  match_signing("appstore", platform: :ios)
  build_number = next_build_number(platform: "ios")
  ipa = with_lodge_signing("appstore", platform: :ios, target: target.name) do |identity|
    build_app(
      project: PROJECT,
      scheme: target.name,
      export_method: "app-store",
      output_directory: File.join(OUTPUT_DIR, "ios", target.name),
      export_options: { signingCertificate: identity },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )
  end
  upload_to_testflight(ipa: ipa, app_platform: "ios", **asc_auth)
end

def match_signing(type, platform: :macos, **extra)
  match(
    type: type,
    platform: platform.to_s,
    app_identifier: ENV["APP_IDENTIFIER"],
    team_id: ENV["APPLE_TEAM_ID"],
    git_url: ENV["MATCH_GIT_URL"],
    readonly: ENV["MATCH_READONLY"].to_s.strip.downcase != "false",
    **asc_auth,
    **extra
  )
end

def project_root
  File.expand_path("..", __dir__)
end

def lodge_version
  @lodge_version ||= get_version_number(xcodeproj: PROJECT, target: "Lodge")
end

def release_tag
  "v#{lodge_version}"
end

def asc_api_key
  return @asc_api_key if defined?(@asc_api_key)

  @asc_api_key =
    if asc_key_ready?
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: asc_key_path,
        in_house: false
      )
    else
      UI.important("No App Store Connect key -- signing in with APPLE_ID; you may be asked for a second factor")
      nil
    end
end

# The API key when there is one, else the Apple ID (its password is fastlane's
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD).
def asc_auth
  asc_api_key ? { api_key: asc_api_key } : { username: ENV["APPLE_ID"] }
end

def next_build_number(platform: "osx")
  latest_testflight_build_number(
    app_identifier: ENV["APP_IDENTIFIER"],
    platform: platform,
    initial_build_number: 0,
    **asc_auth
  ).to_i + 1
end

# A release ships one commit, the one on origin/main, under a tag and GitHub release not yet taken.
def require_releasable
  require_clean_tree
  require_head_on_origin_main
  stop!("tag #{release_tag} already exists", "bump MARKETING_VERSION") if git_tag_exists(tag: release_tag)
  require_new_github_release if github_release?
end

def require_clean_tree
  dirty = sh("git", "status", "--porcelain", log: false).lines.map { |line| line[3..].strip }
  return if dirty.empty?

  more = dirty.size > 10 ? ["    ... and #{dirty.size - 10} more"] : []
  stop!(["git tree is not clean (#{dirty.size} path(s)); commit or stash first:",
         *dirty.first(10).map { |path| "    #{path}" }, *more].join("\n"))
end

def require_head_on_origin_main
  sh("git", "fetch", "origin", "main")
  head = sh("git", "rev-parse", "--short", "HEAD", log: false).strip
  origin = sh("git", "rev-parse", "--short", "origin/main", log: false).strip
  return if sh("git", "rev-parse", "HEAD", log: false) == sh("git", "rev-parse", "origin/main", log: false)

  stop!("HEAD #{head} is not origin/main #{origin}", "push, or check out main and pull")
end

def security(*args)
  output, status = Open3.capture2("security", *args, err: File::NULL)
  status.success? ? output : ""
end

# [fingerprint, name] of each valid signing identity in the keychain.
def keychain_identities(*policy)
  security("find-identity", "-v", *policy).scan(/^\s*\d+\) (\h{40}) "([^"]+)"/)
end

# The keychain may hold several valid identities with the same name (one per renewal), and a
# name lets xcodebuild pick one the profile does not list. The profile carries the certificates
# it accepts; the fingerprint of the one also in this keychain names exactly one identity.
def identity_for(type, platform: :macos)
  profile = match_env(type, "profile-path", platform: platform)
  plist = Plist.parse_xml(security("cms", "-D", "-i", profile))
  accepted = Array(plist && plist["DeveloperCertificates"]).map do |der|
    Digest::SHA1.hexdigest(der.respond_to?(:string) ? der.string : der.to_s).upcase
  end
  installed = keychain_identities.map(&:first)
  (accepted & installed).first ||
    stop!("none of the #{accepted.size} certificates in #{File.basename(profile)} is in this keychain",
          "run match again, or check the certificate has not expired")
end

# No profile lists installer certificates, so any valid one of the team signs the pkg; with
# several (one per renewal) the fingerprint of the one that expires last is used, since an
# installer name alone is as ambiguous as the app identity's.
def installer_identity
  team = ENV["APPLE_TEAM_ID"]
  candidates = keychain_identities("-p", "basic").select do |_, name|
    name.start_with?("3rd Party Mac Developer Installer:", "Mac Installer Distribution:") && name.end_with?("(#{team})")
  end
  if candidates.empty?
    stop!("No valid Mac installer certificate for team #{team} in the keychain",
          "run match appstore with MATCH_READONLY=false, or install the installer certificate")
  end
  candidates.map(&:first).max_by { |fingerprint| certificate_expiry(fingerprint, candidates.to_h[fingerprint]) }
end

def certificate_expiry(fingerprint, name)
  pems = security("find-certificate", "-a", "-Z", "-p", "-c", name)
  pem = pems.scan(/SHA-1 hash: (\h{40})\n(-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----)/m).to_h[fingerprint]
  pem ? OpenSSL::X509::Certificate.new(pem).not_after : Time.at(0)
end

# match leaves the platform out of iOS variable names.
def match_env(type, suffix, platform: :macos)
  name = ["sigh", ENV["APP_IDENTIFIER"], type, (platform.to_s unless platform.to_s == "ios"), suffix].compact.join("_")
  ENV[name].to_s.strip.empty? ? stop!("match did not set #{name}", "check APP_IDENTIFIER and the match type") : ENV[name]
end

# Sign only the app target (xcargs would also reach the LodgeKit SwiftPM targets),
# and always put the committed project file back, keeping any uncommitted edits.
# Yields the identity's fingerprint, for the export's signingCertificate: without it
# -exportArchive picks by its default selector, which may be a same-name certificate.
def with_lodge_signing(type, platform: :macos, target: "Lodge")
  pbxproj = File.join(project_root, PBXPROJ)
  backup = File.join(project_root, PBXPROJ_BACKUP)
  FileUtils.mkdir_p(File.dirname(backup))
  FileUtils.cp(pbxproj, backup)
  identity = identity_for(type, platform: platform)
  begin
    update_code_signing_settings(
      path: PROJECT,
      targets: [target],
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      bundle_identifier: ENV["APP_IDENTIFIER"],
      code_sign_identity: identity,
      profile_name: match_env(type, "profile-name", platform: platform)
    )
    yield identity
  ensure
    FileUtils.cp(backup, pbxproj)
  end
end

# Runs before any build, so a taken version or a bad token fails before TestFlight.
# The token must push to the repo (a typo or unseen repo would also answer 404 below).
# A 404 means the release is free; any other error (401, 403, ...) stops publish.
# Bearer, because GitHub ignores a malformed Basic token and answers 404 instead of 401.
def require_new_github_release
  repository = ENV["GITHUB_REPOSITORY"]
  cannot_publish = ["token cannot publish to #{repository}", "check GITHUB_TOKEN (needs contents: write) and GITHUB_REPOSITORY"]
  repo = github_api(
    api_bearer: ENV["GITHUB_TOKEN"],
    http_method: "GET",
    path: "repos/#{repository}",
    error_handlers: { "*" => proc { stop!(*cannot_publish) } }
  )
  stop!(*cannot_publish) unless repo[:json].dig("permissions", "push") == true

  result = github_api(
    api_bearer: ENV["GITHUB_TOKEN"],
    http_method: "GET",
    path: "repos/#{repository}/releases/tags/#{release_tag}",
    error_handlers: {
      404 => proc {},
      "*" => proc do |response|
        stop!("GitHub answered #{response[:status]} for #{repository} releases", "check GITHUB_TOKEN and GITHUB_REPOSITORY")
      end
    }
  )
  return unless result[:status].between?(200, 299)

  stop!("GitHub release #{release_tag} already exists in #{repository}", "bump MARKETING_VERSION")
end

def release_on_github(dmg)
  repository = ENV["GITHUB_REPOSITORY"]
  set_github_release(
    repository_name: repository,
    api_token: ENV["GITHUB_TOKEN"],
    name: release_tag,
    tag_name: release_tag,
    commitish: last_git_commit[:commit_hash],
    upload_assets: [dmg]
  )
end
